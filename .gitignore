# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# venv / uv
.venv/

# tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# scan output / artifacts
output/
*.audit.jsonl
out.json
dryrun.json
test-results/

# internal / dev-only dirs (never publish)
memory/
.claude/
.mcp.json
graphify-out/
TASKS.md

# tests/ is kept local-only by owner's choice — never tracked or published.
tests/

# NOTE: uv.lock is deliberately NOT ignored — committed so CI is reproducible.

# database & runtime
*.db
*.sqlite
*.sqlite3
*.jsonl

# OS
Thumbs.db
.DS_Store

# Go engine build artifacts (single static binary; built from engine/).
# Anchor the extension-less binary so a bare "banshee-engine" pattern does not
# also ignore the engine/cmd/banshee-engine/ source directory.
banshee-engine.exe
/banshee-engine
engine/banshee-engine
engine/banshee-engine.exe
